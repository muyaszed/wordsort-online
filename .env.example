# ─── Web App (apps/web) — set in Vercel dashboard ───────────────────────────
# URL of the deployed API (server-side Next.js Server Components)
API_URL=https://your-api.railway.app

# URL of the deployed API (browser-side fetches — must include /api prefix)
NEXT_PUBLIC_API_URL=https://your-api.railway.app/api

# Sentry error tracking (optional — leave blank to disable)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ─── API Server (apps/api) — set in Railway/Render/Fly.io ───────────────────
# Note: the API uses Socket.IO and requires a persistent server (not Vercel).

# PostgreSQL connection string (Neon recommended for serverless-compatible pooling)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/wordsort?sslmode=require

# JWT signing secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=

# Google OAuth credentials (leave blank to disable Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the redirect URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI=https://your-api.railway.app/api/auth/callback/google

# Upstash Redis REST credentials (free tier at console.upstash.com)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# API server port (default: 3001)
PORT=3001

# CORS: the deployed web app origin (no trailing slash)
WEB_ORIGIN=https://your-app.vercel.app

# OpenAI API key (puzzle generation)
OPENAI_API_KEY=
